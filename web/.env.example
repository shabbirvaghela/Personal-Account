VITE_API_BASE=http://localhost:4000
# Optional: enables the "Sign in with Google" button. Get one from
# https://console.cloud.google.com/apis/credentials — create an OAuth
# client ID of type "Web application" and add your app's URL(s) under
# "Authorized JavaScript origins" (e.g. http://localhost:5173 for local
# testing, and your real domain once deployed).
VITE_GOOGLE_CLIENT_ID=
