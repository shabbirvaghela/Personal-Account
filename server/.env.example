PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Postgres connection string — a free Supabase project's "Transaction pooler"
# URI (Project Settings > Database > Connection string > Transaction mode,
# port 6543) works well for both serverless (Vercel) and long-running
# (local/Fly) deployments. Any Postgres works too, e.g.
# postgresql://ledger:ledgerpass@localhost:5432/legal_ledger for local dev.
DATABASE_URL=
CORS_ORIGIN=http://localhost:5173
# Optional: same Google OAuth Client ID as web/.env.example's
# VITE_GOOGLE_CLIENT_ID. Required for "Sign in with Google" to work —
# the server verifies Google's ID token against this audience.
GOOGLE_CLIENT_ID=
